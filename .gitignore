.vscode/
!.vscode/extensions.json
!.vscode/launch.json

# WebStorm / IntelliJ
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Sublimetext / Vim
*.sublime-workspace
*.swp
*~

#======================================================================
